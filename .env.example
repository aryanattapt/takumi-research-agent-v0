# Copy to .env and replace both secrets with fresh random values.
# Use a URL-safe alphanumeric PostgreSQL password so DATABASE_URL needs no escaping.
POSTGRES_PASSWORD=replace-with-a-random-32-character-password
DATABASE_URL=postgresql+psycopg://takumi:replace-with-a-random-32-character-password@postgres:5432/takumi

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TAKUMI_MASTER_KEY=replace-with-a-random-secret-of-at-least-32-characters

# Browser access over local HTTP; set true behind HTTPS in production.
SESSION_COOKIE_SECURE=false
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# Worker lanes and the wall-clock estimate used by deadline admission control.
# Both the worker and the API read these keys; they must match for at_risk to stay honest.
WORKER_CONCURRENCY=2
CAPACITY_RUN_MINUTES=45

DATA_DIR=/data
WEB_DIST_DIR=/app/web-dist
AGENT_HEADLESS=true
TZ=Asia/Jakarta

# Exact domains and subdomains accepted for public source retrieval.
RESEARCH_ALLOWED_DOMAINS=api.crossref.org,europepmc.org,ebi.ac.uk,doaj.org,doi.org,pmc.ncbi.nlm.nih.gov,arxiv.org,export.arxiv.org,hn.algolia.com,joss.theoj.org
# Optional curated public RSS feeds. Each host must also appear in RESEARCH_ALLOWED_DOMAINS.
# Format: [{"name":"lab-news","url":"https://example.org/feed.xml","field":"biology"}]
TREND_RSS_FEEDS=[]

# Exact hosts permitted for remote OpenAPI contracts and explicitly private HTTP endpoints.
# Example: api.example.com,blog-api.internal
ADMIN_ENDPOINT_ALLOWLIST=
