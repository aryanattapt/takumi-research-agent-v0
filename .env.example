# Local model via Ollama OpenAI-compatible API. Search itself needs no paid API.
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_NAME=qwen3
MODEL_API_KEY=ollama

# Blog API. Point BLOG_API_SPEC at an OpenAPI JSON/YAML file or URL.
BLOG_BASE_URL=
BLOG_API_TOKEN=
BLOG_API_SPEC=
# Use these only when OpenAPI does not describe authentication.
BLOG_API_AUTH_HEADER=
BLOG_API_AUTH_SCHEME=Bearer

DATA_DIR=./data
AGENT_HEADLESS=true
TZ=Asia/Jakarta
RESEARCH_ALLOWED_DOMAINS=crossref.org,api.crossref.org,europepmc.org,ebi.ac.uk,doaj.org,doi.org,pmc.ncbi.nlm.nih.gov,joss.theoj.org
MAX_AGENT_STEPS=40
MAX_RESEARCH_RETRIES=2
